{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "wavey-id-worker",
  "main": "src/worker.js",
  "compatibility_date": "2026-06-02",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "c57bb20727aa3564966d2bb693abddce",
  "workers_dev": false,
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "id.wavey.ai/*",
      "zone_name": "wavey.ai"
    }
  ],
  "vars": {
    "PUBLIC_BASE_URL": "https://id.wavey.ai",
    "AUTH0_DOMAIN": "wavey.eu.auth0.com",
    "AUTH0_CLIENT_ID": "kbYi74h32G4TbrTVre2mQOO1ZJl3i0wF",
    "AUTH0_SCOPE": "openid profile email",
    "SESSION_TTL_SECONDS": "86400",
    "COOKIE_NAME": "wavey_id_session",
    "TX_COOKIE_NAME": "wavey_id_tx",
    "COOKIE_DOMAIN": "id.wavey.ai",
    "ALLOWED_ORIGINS": "https://bitneedle.com,https://www.bitneedle.com,https://infidelity.io,https://www.infidelity.io,https://id.wavey.ai",
    "ALLOWED_RETURN_ORIGINS": "https://bitneedle.com,https://www.bitneedle.com,https://infidelity.io,https://www.infidelity.io,https://id.wavey.ai"
  }
}
