{
  "name": "@wavey-ai/wavey-id",
  "version": "0.1.0",
  "description": "Shared id.wavey.ai Cloudflare Worker deployment for Wavey login.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/worker.js"
  },
  "scripts": {
    "check": "node --check src/worker.js && node --check scripts/verify-auth0-config.mjs && node --check scripts/patch-auth0-client.mjs && node --check scripts/zeroth-cloudflare.mjs && node --check scripts/verify-zeroth-config.mjs && node --check scripts/zeroth-apple-status.mjs && node --check scripts/zeroth-apple-provision.mjs && node --check scripts/zeroth-provider-status.mjs && node --check scripts/zeroth-provider-status.test.mjs && node --check scripts/zeroth-deploy-preflight.mjs && node --check scripts/zeroth-live-status.mjs && node --check scripts/zeroth-rollout-status.mjs && node --check scripts/zeroth-backend-status.mjs && node --check scripts/zeroth-backend-status.test.mjs && node --check scripts/zeroth-startup-profile.mjs && node --check scripts/zeroth-startup-profile.test.mjs && node --check scripts/zeroth-swift-status.mjs && node --check scripts/zeroth-swift-status.test.mjs && node --test src/worker.test.mjs scripts/zeroth-startup-profile.test.mjs scripts/zeroth-provider-status.test.mjs scripts/zeroth-backend-status.test.mjs scripts/zeroth-swift-status.test.mjs",
    "dev": "wrangler dev --config wrangler.jsonc",
    "deploy": "wrangler deploy --config wrangler.jsonc",
    "deploy:dry-run": "wrangler deploy --config wrangler.jsonc --dry-run",
    "types": "wrangler types --config wrangler.jsonc src/worker-configuration.d.ts",
    "patch:auth0": "node scripts/patch-auth0-client.mjs",
    "verify:auth0": "node scripts/verify-auth0-config.mjs",
    "zeroth:build": "cd ../zeroth/crates/zeroth-worker && worker-build --release",
    "zeroth:dev": "node scripts/zeroth-cloudflare.mjs npx wrangler@4.93.0 dev --config wrangler.zeroth.jsonc",
    "zeroth:deploy": "node scripts/zeroth-cloudflare.mjs npx wrangler@4.93.0 deploy --config wrangler.zeroth.jsonc",
    "zeroth:deploy:dry-run": "node scripts/zeroth-cloudflare.mjs npx wrangler@4.93.0 deploy --config wrangler.zeroth.jsonc --dry-run",
    "zeroth:deploy:preflight": "node scripts/zeroth-cloudflare.mjs node scripts/zeroth-deploy-preflight.mjs",
    "zeroth:deploy:preflight:local": "node scripts/zeroth-cloudflare.mjs node scripts/zeroth-deploy-preflight.mjs --allow-placeholders",
    "zeroth:deploy:preflight:startup": "node scripts/zeroth-cloudflare.mjs node scripts/zeroth-deploy-preflight.mjs --allow-placeholders --with-startup-check",
    "zeroth:d1:init": "node scripts/zeroth-cloudflare.mjs bash scripts/zeroth-d1-init.sh",
    "zeroth:schema": "cd ../zeroth && cargo run -p zeroth-cli -- schema",
    "zeroth:signing-key": "cd ../zeroth && cargo run -p zeroth-cli -- signing-key",
    "zeroth:apple:provision": "node scripts/zeroth-apple-provision.mjs",
    "zeroth:apple:status": "node scripts/zeroth-apple-status.mjs",
    "zeroth:providers:status": "node scripts/zeroth-provider-status.mjs",
    "zeroth:providers:status:remote": "node scripts/zeroth-cloudflare.mjs node scripts/zeroth-provider-status.mjs --remote",
    "zeroth:swift:status": "node scripts/zeroth-swift-status.mjs",
    "zeroth:swift:require": "node scripts/zeroth-swift-status.mjs --require-ready",
    "zeroth:backend:status": "node scripts/zeroth-cloudflare.mjs node scripts/zeroth-backend-status.mjs",
    "zeroth:backend:require": "node scripts/zeroth-cloudflare.mjs node scripts/zeroth-backend-status.mjs --require-backend",
    "zeroth:secrets": "node scripts/zeroth-cloudflare.mjs bash scripts/set-zeroth-secrets.sh",
    "zeroth:secrets:check": "node scripts/zeroth-cloudflare.mjs bash scripts/set-zeroth-secrets.sh --check",
    "zeroth:secrets:apple": "node scripts/zeroth-cloudflare.mjs bash scripts/set-zeroth-secrets.sh --apple-only",
    "zeroth:secrets:apple:check": "node scripts/zeroth-cloudflare.mjs bash scripts/set-zeroth-secrets.sh --check --apple-only",
    "zeroth:secrets:bootstrap": "node scripts/zeroth-cloudflare.mjs bash scripts/set-zeroth-secrets.sh --bootstrap-only --env-file .wrangler/zeroth-bootstrap.env",
    "zeroth:secrets:bootstrap:check": "node scripts/zeroth-cloudflare.mjs bash scripts/set-zeroth-secrets.sh --check --bootstrap-only --env-file .wrangler/zeroth-bootstrap.env",
    "zeroth:verify": "node scripts/verify-zeroth-config.mjs",
    "zeroth:verify:local": "node scripts/verify-zeroth-config.mjs --allow-placeholders",
    "zeroth:verify:live": "node scripts/verify-zeroth-config.mjs --live",
    "zeroth:verify:live:admin": "node scripts/verify-zeroth-config.mjs --live --require-admin",
    "zeroth:verify:live:admin:bootstrap": "node scripts/verify-zeroth-config.mjs --allow-placeholders --allow-not-ready --live --require-admin --env-file .wrangler/zeroth-bootstrap.env",
    "zeroth:live:status": "node scripts/zeroth-live-status.mjs",
    "zeroth:live:require": "node scripts/zeroth-live-status.mjs --require-zeroth",
    "zeroth:startup:check": "node scripts/zeroth-cloudflare.mjs npx wrangler@4.93.0 check startup --config wrangler.zeroth.jsonc",
    "zeroth:rollout:status": "node scripts/zeroth-cloudflare.mjs node scripts/zeroth-rollout-status.mjs",
    "zeroth:rollout:status:build": "node scripts/zeroth-cloudflare.mjs node scripts/zeroth-rollout-status.mjs --with-build",
    "zeroth:rollout:status:startup": "node scripts/zeroth-cloudflare.mjs node scripts/zeroth-rollout-status.mjs --with-startup-check",
    "zeroth:rollout:require": "node scripts/zeroth-cloudflare.mjs node scripts/zeroth-rollout-status.mjs --require-ready",
    "zeroth:startup:profile": "node scripts/zeroth-startup-profile.mjs"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "wrangler": "^4.96.0"
  }
}
